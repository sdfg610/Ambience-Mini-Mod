/* This file contains the Token specification and Grammar which COCO/R uses to construct the scanner
and parser. COCO/R uses Extend Bacus-Naur form (EBNF) for the grammar, as well as its own series of commands
which will be explained when met first in context.  */

// The scanner/lexer and parser files are created by inserting generated code (based on this .ATG file)
// into the "Scanner.frame" and "Parser.frame" files located alongside the Dims.ATG file.

/* The EBNF uses the following extensions: */
/* [] Brackets mean that the string is written zero or one times.  */
/* {} Curly brackets mean that the string is repeated zero or more times  */
/* () is a grouping used alongside |. The parenthesis contains a series of strings separated by |. This means that exactly one of the strings is chosen. */

/* Imports here are inserted at the top of the generated lexer and parser. */
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.expression.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.schedule.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.server_playlists.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.type.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.misc.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.abstract_syntax.*;
import me.molybdenum.ambience_mini.engine.shared.configuration.messages.Message;
import me.molybdenum.ambience_mini.engine.shared.configuration.messages.SynError;

import java.io.InputStream;
import java.util.ArrayList;
import java.util.HashMap;

/* The required start of a Coco/R grammar file. "Program" specifies the starting symbol of the grammar. */
COMPILER File

/* Code here is injected at the start of the parser class. */
    Config mainNode = null; // This contains the AST generated by calling parser.Parse().

    private static String removeFirstAndLast(String str) {
        return str.substring(1, str.length() - 1);
    }

/*------------------------------------------------------------------------*/
/* The following section contains the token specification of Dims.*/
CHARACTERS
  letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" .
  digit = "0123456789" .
  lf  = '\n' .
  stringChar = ANY - lf - '\r' - '"'.

TOKENS
  IDENT  = ('_' | letter) {letter | digit | '_'}  .
  INT    = digit {digit}  .
  FLOAT  = digit {digit} '.' digit {digit}  .
  STRING = '"' {stringChar} '"' .

COMMENTS FROM "/*" TO "*/" NESTED  /* Nested means: "There can be comments inside comments" */
COMMENTS FROM "//" TO lf

IGNORE '\r' + '\n' + '\t' /* These characters are ignored by the lexer */


/*------------------------------------------------------------------------*/
/* The rest of the file contains the grammar for the Ambience Mini configuration language.  */
PRODUCTIONS

/*------------------------------------------------------------------------*/
// Configurations
File = Conf<out mainNode> .

Conf<out Config conf>              (. var declarations = new ArrayList<GlobalDecl>(); ServerPlaylists serverPl = null; Schedule schedule = null; .)
    = { Decl<out GlobalDecl decl>  (. declarations.add(decl); .)
    } [ "serve_playlists" ':' ServerPlaylists<out serverPl>
    ] [ Shed<out schedule>
    ]                              (. conf = new Config(declarations, serverPl, schedule); .)
.
/* | "preset" STRING [ "default" ] ':' */


/*------------------------------------------------------------------------*/
// Global declarations
Decl<out GlobalDecl decl>
     = Type<out Type type> IDENT      (. Ident ident = new Ident(t.val, t.line); .)
         '=' Expr<out Expr expr> ';'  (. decl = new GlobalDecl(type, ident, expr); .)
.


/*------------------------------------------------------------------------*/
// Server playlist configuration
ServerPlaylists<out ServerPlaylists serverPl>  (. serverPl = null; .)
    = Expr<out Expr expr> ';'   (. serverPl = new PlaylistInstance(expr); .)
    | "group"                                         (. HashMap<String, ServerPlaylists> groups = new HashMap<>(); .)
      { STRING                                        (. String groupName = removeFirstAndLast(t.val); .)
        ':' ServerPlaylists<out ServerPlaylists serverPl2>   (. groups.put(groupName, serverPl2); .)
      }
      "end"                                           (. serverPl = new PlaylistGroup(groups); .)
.


/*------------------------------------------------------------------------*/
// Preset configuration


/*------------------------------------------------------------------------*/
// Schedules / Client music selection strategy
Shed<out Schedule schedule>                  (. schedule = null; boolean instant = false; boolean ifdef = false; .)
    = "play"                          (. int line = t.line; .)
      { "instant"                     (. instant = true; .)
      | "ifdef"                       (. ifdef = true; .)
      } Expr<out Expr expr>           (. IntLit priority = null; .)
      [ "priority" INT                (. priority = new IntLit(Integer.parseInt(t.val), t.line); .)
      ]
      ';'                             (. schedule = new Play(expr, instant, ifdef, priority, line); .)
    | "use_vanilla_player"            (. int line = t.line; .)
      ';'                             (. schedule = new Vanilla(line); .)
    | "begin"                                (. ArrayList<Schedule> body = new ArrayList<>(); int line = t.line; .)
      { Shed<out Schedule schedule2>         (. body.add(schedule2); .)
      }
      "end"                                  (. schedule = new Block(body, line); .)
    | "when"                                   (. int line = t.line; .)
      '(' Expr<out Expr expr>
      ')' Shed<out Schedule schedule2>         (. schedule = new When(expr, schedule2, line); .)
    | "let"                               (. int line = t.line; Type type = null; .)
      IDENT                               (. Ident ident = new Ident(t.val, t.line); .)
      [ ':' Type<out type> ]
      '=' Expr<out Expr expr>
      "in" Shed<out Schedule shed>        (. schedule = new Let(type, ident, expr, shed, line); .)
    | "default" Shed<out schedule>
    | "interrupt"                       (. int line = t.line; .)
      Shed<out Schedule schedule2>      (. schedule = new Interrupt(schedule2, line); .)
.


/*------------------------------------------------------------------------*/
// Expressions
Expr<out Expr expr>              (. BinaryOperators op; int line = -1; .)
    = ExprEq<out expr>
    { ( "&&"                     (. op = BinaryOperators.AND; line = t.line; .)
      | "||"                     (. op = BinaryOperators.OR; line = t.line; .)
      ) ExprEq<out Expr expr2>   (. expr = new BinaryOp(op, expr, expr2, line); .)
    }
.

ExprEq<out Expr expr>            (. BinaryOperators op; int line = -1; .)
    = ExprRel<out expr>
    { ( "=="                     (. op = BinaryOperators.EQ; line = t.line; .)
      | "~~"                     (. op = BinaryOperators.APP_EQ; line = t.line; .)
      | "*~"                     (. op = BinaryOperators.MATCH; line = t.line; .)
      ) ExprRel<out Expr expr2>  (. expr = new BinaryOp(op, expr, expr2, line); .)
      | "!="                     (. line = t.line; .)
        ExprRel<out Expr expr2>  (. expr = new UnaryOp(UnaryOperators.NOT, new BinaryOp(BinaryOperators.EQ, expr, expr2, line), line); .)
    }
.

ExprRel<out Expr expr>            (. int line = -1; .)
    = ExprAdd<out expr>
      { "<" (. line = t.line; .)
        ExprAdd<out Expr expr2> (. expr = new BinaryOp(BinaryOperators.LT, expr, expr2, line); .)
      | ">" (. line = t.line; .)
        ExprAdd<out Expr expr2> (. expr = new BinaryOp(BinaryOperators.LT, expr2, expr, line); .)
      | "<=" (. line = t.line; .)
        ExprAdd<out Expr expr2> (. expr = new BinaryOp(BinaryOperators.LE, expr, expr2, line); .)
      | ">=" (. line = t.line; .)
        ExprAdd<out Expr expr2> (. expr = new BinaryOp(BinaryOperators.LE, expr2, expr, line); .)
      }
.

ExprAdd<out Expr expr>    (. BinaryOperators op; int line = -1; .)
    = ExprMul<out expr>
      { ( '+'               (. op = BinaryOperators.ADD; line = t.line; .)
        | '-'               (. op = BinaryOperators.SUB; line = t.line; .)
        )
        ExprMul<out Expr expr2>  (. expr = new BinaryOp(op, expr, expr2, line); .)
      }
.

ExprMul<out Expr expr>    (. BinaryOperators op; int line = -1; .)
    = ExprPre<out expr>
      { ( '*'               (. op = BinaryOperators.MUL; line = t.line; .)
        | '/'               (. op = BinaryOperators.DIV; line = t.line; .)
        | "++"              (. op = BinaryOperators.APPEND; line = t.line; .)
        )
        ExprPre<out Expr expr2>  (. expr = new BinaryOp(op, expr, expr2, line); .)
      }
.

ExprPre<out Expr expr> (. expr = null; UnaryOperators op; int line; .)
    = ( '!'  (. op = UnaryOperators.NOT; .)
      | '-'  (. op = UnaryOperators.NEG; .)
      )      (.  line = t.line; .)
      ExprPre<out expr>  (. expr = new UnaryOp(op, expr, line); .)
    | ExprSuf<out expr>
.

ExprSuf<out Expr expr>
    = ExprTerm<out expr>
      { '['                       (. int line = t.line; .)
        Expr<out Expr index> ']'  (. expr = new BinaryOp(BinaryOperators.INDEXER, expr, index, line); .)
      | '.'    (. int line = t.line; .)
        IDENT  (. expr = new Accessor(expr, new Ident(t.val, t.line), line); .)
      }
.

ExprTerm<out Expr expr> (. expr = null; Quantifiers quantifier = Quantifiers.ANY; .)
    = IDENT             (. expr = new Ident(t.val, t.line);                      .)
    | Const<out expr>
    | '@' IDENT         (. expr = new GetEvent(new Ident(t.val, t.line));    .)
    | '$' IDENT         (. expr = new GetProperty(new Ident(t.val, t.line)); .)
    | ("any" | "all"    (. quantifier = Quantifiers.ALL; .)
      ) IDENT           (. String identifier = t.val; int line = t.line; .)
      "in"                        (. int inLine = t.line; .)
      Expr<out Expr list> "has" (. int whereLine = t.line; .)
      Expr<out Expr cond> "end"
                        (. expr = new QuantifierOp(quantifier, new Ident(identifier, line), list, cond, inLine, whereLine); .)
    | '(' Expr<out expr> ')'
    | '['                                  (. expr = new PlaylistLit(t.line); .)
          [ Music<out PlaylistLit.Load load>  (. ((PlaylistLit)expr).music().add(load); .)
            { ',' Music<out load>          (. ((PlaylistLit)expr).music().add(load); .)
            }
          ]
      ']'
.

Const<out Expr expr>    (. expr = null;                                             .)
    = "undefined"       (. expr = new UndefinedLit(t.line);                         .)
    | "true"            (. expr = new BoolLit(true, t.line);                        .)
    | "false"           (. expr = new BoolLit(false, t.line);                       .)
    | STRING            (. expr = new StringLit(removeFirstAndLast(t.val), t.line); .)
    | Num<out expr>
.

Music<out PlaylistLit.Load load>
    = STRING                   (. StringLit file = new StringLit(removeFirstAndLast(t.val), t.line); int line = t.line; var args = new ArgList(); .)
        [ '<'
          MusicArgs<args>
          '>'
        ]                      (. load = new PlaylistLit.Load(file, args, line); .)
.

MusicArgs<ArgList args>
    = MusicArg<out Arg arg1>   (. if (arg1 != null) args.add(arg1); .)
      { ','
        MusicArg<out Arg arg2>   (. if (arg2 != null) args.add(arg2); .)
      }
.

MusicArg<out Arg arg>    (. arg = null; .)
    = Num<out Expr expr> (. arg = new Arg(new Ident("gain", t.line), expr); .)
    | IDENT              (. Ident ident = new Ident(t.val, t.line); Expr expr = new BoolLit(true, t.line); .)
      [ '='              (. expr = null; .) // Set expr to null to avoid weird typing errors when arg has syntax errors
        (Const<out expr> | '(' Expr<out expr> ')')
      ]                  (. arg = new Arg(ident, expr); .)
.

Num<out Expr expr>      (. expr = null; int sign = 1; .)
    = [ '-'             (. sign = -1; .)
      | '+']
        ( INT           (. expr = new IntLit(Integer.parseInt(t.val) * sign, t.line);      .)
        | FLOAT         (. expr = new FloatLit(Float.parseFloat(t.val) * sign, t.line);    .)
        )
.


/*------------------------------------------------------------------------*/
// Types
Type<out Type type>  (. type = null; .)
    = "bool"         (. type = BoolT.INSTANCE; .)
    | "int"          (. type = IntT.INSTANCE; .)
    | "float"        (. type = FloatT.INSTANCE; .)
    | "string"       (. type = StringT.INSTANCE; .)
    | "area"         (. type = AreaT.INSTANCE; .)
    | "combatant"    (. type = CombatantT.INSTANCE; .)
    | "playlist"     (. type = PlaylistT.INSTANCE; .)
    | "list" '<' Type<out Type elemType> '>' (. type = new ListT(elemType); .)
    | "map" '<' Type<out Type elemType1> ',' Type<out Type elemType2> '>' (. type = new MapT(elemType1, elemType2); .)
.

END File. // Must refer to the same non-terminal as "COMPILER" at the top.